# DSH Skills — .gitignore

# DSH runtime files
.dsh/
.dsh-credentials/

# OS files
.DS_Store
.DS_Store.local
._*
Thumbs.db
desktop.ini

# Editor directories and files
*.swp
*.swo
*~
.vscode/
.idea/
*.iml
.c9/
.sublime-project
.sublime-workspace
*.log

# Dependency directories
node_modules/
vendor/

# Build outputs
dist/
build/
native-dist/

# Environment files
.env
.env.local
.env.*.local
.dev.vars

# Git hooks
.hooks/

# Temporary files
*.tmp
*.bak
.cache/
.tmp/

# Python
__pycache__/
*.pyc
*.pyo

# Documentation builds
site/
docs/_build/
